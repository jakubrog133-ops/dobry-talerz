<script>
'use strict';
const RECIPES = [{"id":"d1m1","day":1,"slot":0,"type":"Śniadanie","title":"Jajecznica ze szczypiorkiem","description":"Jajecznica z 3 jajek z mrożonym szczypiorkiem. Podawana z chlebem żytnim, lekkim serkiem, pomidorem i rzodkiewką.","ingredients":["Jajka (3 szt.)","Szczypiorek (mrożony)","Chleb żytni bez drożdży (2 kromki)","Serek kanapkowy lekki","Pomidor","Rzodkiewka"],"imageKey":"lidl-photo-p02"},{"id":"d1m2","day":1,"slot":1,"type":"II śniadanie","title":"Tortilla z indykiem i szpinakiem","description":"Pełnoziarnista tortilla z wędliną z piersi indyka bez azotynu sodu, świeżym szpinakiem, pomidorkami i keczupem bez cukru.","ingredients":["Tortilla pełnoziarnista","Wędlina z piersi indyka bez azotynu sodu","Szpinak świeży","Pomidorki koktajlowe","Keczup bez cukru"],"imageKey":"dash-d6-s4","image":"https://images.unsplash.com/photo-1731090389603-d63060ee08a6?auto=format&fit=crop&w=750&q=78","imageSource":"https://unsplash.com/photos/a-burrito-cut-in-half-on-a-plate-BqV9zOdio6A","imageAuthor":"Snappr","imageFallback":"dash-d6-s4"},{"id":"d1m3","day":1,"slot":2,"type":"Obiad","title":"Makaron z tuńczykiem i brokułami","description":"Makaron pełnoziarnisty i durum w proporcji 50/50, z tuńczykiem, szpinakiem, brokułami i pomidorkami, podsmażonymi na oliwie.","ingredients":["Makaron pełnoziarnisty","Makaron durum","Tuńczyk w sosie własnym","Szpinak","Brokuły","Pomidorki koktajlowe","Oliwa z oliwek"],"imageKey":"dash-d5-s2"},{"id":"d1m4","day":1,"slot":3,"type":"Kolacja","title":"Owsianka „Ala Mars”","description":"Owsianka na mleku 1,5% z masłem orzechowym, miodem lub erytrolem i gorzką czekoladą. Przed snem 2 kiwi gold.","ingredients":["Płatki owsiane błyskawiczne","Mleko 1,5%","Masło orzechowe 100%","Miód|Erytrol","Gorzka czekolada min. 70%","Kiwi gold (2 szt.)"],"imageKey":"dash-d2-s0"},{"id":"d2m1","day":2,"slot":0,"type":"Śniadanie","title":"Nocna owsianka z malinami","description":"Płatki owsiane namoczone w napoju owsianym lub mleku, ze skyrem naturalnym, mrożonymi malinami i masłem orzechowym.","ingredients":["Płatki owsiane błyskawiczne","Napój owsiany bez cukru|Mleko 1,5%","Skyr naturalny","Maliny mrożone","Masło orzechowe 100%"],"imageKey":"dash-d7-s0"},{"id":"d2m2","day":2,"slot":1,"type":"II śniadanie","title":"Koktajl białkowo-owocowy","description":"Skyr pitny bez cukru zblendowany z bananem i borówkami.","ingredients":["Skyr pitny bez cukru","Banan","Borówki"],"imageKey":"dash-d6-s1"},{"id":"d2m3","day":2,"slot":2,"type":"Obiad","title":"Kurczak z ryżem i sałatką","description":"Pierś kurczaka z air fryera (lub chude mięso mielone z indyka), ryż basmati, rukola, czerwona papryka i ogórek z oliwą.","ingredients":["Pierś z kurczaka|Mięso mielone z indyka 2% tłuszczu","Ryż basmati","Rukola","Papryka czerwona","Ogórek","Oliwa z oliwek"],"imageKey":"lidl-photo-p18"},{"id":"d2m4","day":2,"slot":3,"type":"Kolacja","title":"Pinsa z łososiem","description":"Pełnoziarnista pinsa z passatą, mozzarellą light, rukolą, pomidorkami i wędzonym dzikim łososiem z Alaski.","ingredients":["Pinsa pełnoziarnista","Passata pomidorowa 99%","Mozzarella light","Rukola","Pomidorki koktajlowe","Wędzony dziki łosoś z Alaski"],"imageKey":"lidl-photo-p03","image":"https://images.unsplash.com/photo-1750943082685-f9c1e15b3273?auto=format&fit=crop&w=750&q=78","imageSource":"https://unsplash.com/photos/salmon-pizza-on-a-red-serving-dish-e5Y6vL7tHeU","imageAuthor":"Tommaso Ubezio","imageFallback":"lidl-photo-p03"},{"id":"d3m1","day":3,"slot":0,"type":"Śniadanie","title":"Twarożek wiosenny","description":"Twaróg półtłusty z kefirem, szczypiorkiem, rzodkiewką i papryką. Do tego grahamka.","ingredients":["Twaróg półtłusty","Kefir","Szczypiorek","Rzodkiewka","Papryka","Bułka grahamka"],"imageKey":"lidl-photo-p13"},{"id":"d3m2","day":3,"slot":1,"type":"II śniadanie","title":"Serek wiejski na słono","description":"Serek wiejski z rzodkiewką, papryką i szczypiorkiem, z dwoma waflami ryżowymi z ciecierzycy.","ingredients":["Serek wiejski","Rzodkiewka","Papryka","Szczypiorek","Wafle ryżowe z ciecierzycy (2 szt.)"],"imageKey":"dash-d1-s4"},{"id":"d3m3","day":3,"slot":2,"type":"Obiad","title":"Stek drobiowy z ziemniakami","description":"Stek z piersi kurczaka lub indyka, gotowane ziemniaki albo puree z serkiem kanapkowym oraz mrożone warzywa.","ingredients":["Pierś z kurczaka|Pierś z indyka","Ziemniaki","Serek kanapkowy lekki (opcjonalnie do puree)","Marchew","Brokuły","Kukurydza"],"imageKey":"dash-d3-s2"},{"id":"d3m4","day":3,"slot":3,"type":"Kolacja","title":"Zapiekanka z pieczarkami","description":"Grahamka lub bagietka z serkiem, passatą, podsmażonymi pieczarkami, czosnkiem, wędliną z indyka, papryką i mozzarellą. Przed snem 2 kiwi gold.","ingredients":["Bułka grahamka|Bagietka","Serek kanapkowy lekki","Passata pomidorowa","Pieczarki","Czosnek","Wędlina z indyka","Papryka","Mozzarella light","Kiwi gold (2 szt.)"],"imageKey":"lidl-photo-p06","image":"https://images.unsplash.com/photo-1631637214648-2c6fd7f947ae?auto=format&fit=crop&w=750&q=78","imageSource":"https://unsplash.com/photos/a-piece-of-bread-with-meat-on-top-of-it-83Lq4rDrx_o","imageAuthor":"Sofia Holmberg","imageFallback":"lidl-photo-p06"},{"id":"d4m1","day":4,"slot":0,"type":"Śniadanie","title":"Pasta jajeczna na chlebie","description":"Pasta z 2 jaj na twardo, lekkiego serka, szczypiorku i pieprzu. Podana na żytnim chlebie z rukolą i pomidorkami.","ingredients":["Jajka (2 szt.)","Serek kanapkowy lekki","Szczypiorek","Pieprz","Chleb żytni bez drożdży","Rukola","Pomidorki koktajlowe"],"imageKey":"lidl-photo-p17b"},{"id":"d4m2","day":4,"slot":1,"type":"II śniadanie","title":"Owsianka ze skyrem i owocami","description":"Owsianka z waniliowym skyrem, mrożonymi truskawkami lub borówkami i orzechami nerkowca lub włoskimi.","ingredients":["Płatki owsiane","Skyr waniliowy","Truskawki mrożone|Borówki mrożone","Orzechy nerkowca|Orzechy włoskie"],"imageKey":"dash-d3-s0"},{"id":"d4m3","day":4,"slot":2,"type":"Obiad","title":"Ryba z pieczonymi ziemniakami","description":"Łosoś lub dorsz z air fryera, pieczone ziemniaki z ziołami i oliwą, sałatka z miksu liści, pomidorków i ogórka.","ingredients":["Łosoś świeży|Dorsz","Ziemniaki","Zioła","Oliwa z oliwek","Miks młodych liści","Pomidorki koktajlowe","Ogórek"],"imageKey":"dash-d4-s2"},{"id":"d4m4","day":4,"slot":3,"type":"Kolacja","title":"Burrito z indykiem","description":"Tortilla pełnoziarnista z grillowanym mielonym indykiem, kukurydzą, passatą, papryką i mozzarellą light.","ingredients":["Tortilla pełnoziarnista","Mięso mielone z indyka 2% tłuszczu","Kukurydza","Passata pomidorowa","Papryka","Mozzarella light"],"imageKey":"dash-d6-s4","image":"https://images.unsplash.com/photo-1731090389603-d63060ee08a6?auto=format&fit=crop&w=750&q=78","imageSource":"https://unsplash.com/photos/a-burrito-cut-in-half-on-a-plate-BqV9zOdio6A","imageAuthor":"Snappr","imageFallback":"dash-d6-s4"},{"id":"d5m1","day":5,"slot":0,"type":"Śniadanie","title":"Pancakes z twarogiem","description":"Naleśniki lub pancakes z mąki pełnoziarnistej i pszennej (50/50) na oliwie, z twarogiem, dżemem i skyrem waniliowym.","ingredients":["Mąka pełnoziarnista typ 1850","Mąka pszenna","Oliwa z oliwek","Twaróg półtłusty","Dżem 100% owoców","Skyr waniliowy"],"imageKey":"dash-d1-s0"},{"id":"d5m2","day":5,"slot":1,"type":"II śniadanie","title":"Kefir z bananem i przekąską","description":"Szklanka kefiru, banan oraz garść suszonych owoców lub orzechów nerkowca.","ingredients":["Kefir","Banan","Suszone śliwki|Daktyle|Orzechy nerkowca"],"imageKey":"lidl-photo-p17a"},{"id":"d5m3","day":5,"slot":2,"type":"Obiad","title":"Gnocchi w sosie pomidorowym","description":"Gnocchi z passatą, pomidorkami koktajlowymi, oliwą, ziołami i kuleczkami mozzarelli light.","ingredients":["Gnocchi (kopytka)","Passata pomidorowa","Pomidorki koktajlowe","Oliwa z oliwek","Zioła","Mozzarella light"],"imageKey":"dash-d5-s2","image":"https://images.unsplash.com/photo-1651773550746-b76fea3cfb70?auto=format&fit=crop&w=750&q=78","imageSource":"https://unsplash.com/photos/a-bowl-of-food-bqs2XoayCt8","imageAuthor":"Max Griss","imageFallback":"dash-d5-s2"},{"id":"d5m4","day":5,"slot":3,"type":"Kolacja","title":"Tosty z indykiem i mozzarellą","description":"Pełnoziarniste tosty z wędliną z indyka, mozzarellą i pomidorem, z papryką i ogórkiem. Przed snem 2 kiwi gold.","ingredients":["Chleb tostowy pełnoziarnisty","Wędlina z indyka","Mozzarella light","Pomidor","Papryka","Ogórek","Kiwi gold (2 szt.)"],"imageKey":"dash-d7-s3"},{"id":"d6m1","day":6,"slot":0,"type":"Śniadanie","title":"Jajka sadzone z awokado","description":"Dwa jajka sadzone na grzance z grahamki z awokado, pomidorkami i szczypiorkiem.","ingredients":["Jajka (2 szt.)","Bułka grahamka","Awokado","Pomidorki koktajlowe","Szczypiorek"],"imageKey":"lidl-photo-p17b"},{"id":"d6m2","day":6,"slot":1,"type":"II śniadanie","title":"Serek wiejski z borówkami","description":"Serek wiejski na słodko z dżemem 100% owoców i świeżymi borówkami.","ingredients":["Serek wiejski","Dżem 100% owoców","Borówki świeże"],"imageKey":"dash-d1-s4"},{"id":"d6m3","day":6,"slot":2,"type":"Obiad","title":"Kurczak z kuskusem","description":"Kurczak z air fryera w sosie własnym, kasza kuskus, brokuł i marchew gotowane na parze.","ingredients":["Pierś z kurczaka","Kasza kuskus","Brokuły","Marchew"],"imageKey":"dash-d1-s2"},{"id":"d6m4","day":6,"slot":3,"type":"Kolacja","title":"Sałatka z wędzonym łososiem","description":"Liście lub rukola, wędzony łosoś z Alaski, awokado, pomidorki, ser proteinowy, oliwa i dwa wafle z ciecierzycy.","ingredients":["Miks młodych liści|Rukola","Wędzony dziki łosoś z Alaski","Awokado","Pomidorki koktajlowe","Ser żółty proteinowy","Oliwa z oliwek","Wafle ryżowe z ciecierzycy (2 szt.)"],"imageKey":"lidl-photo-p19","image":"https://images.unsplash.com/photo-1756138369555-41ef2a10d1df?auto=format&fit=crop&w=750&q=78","imageSource":"https://unsplash.com/photos/salmon-salad-with-fresh-greens-and-lime-ery1HIXFDKw","imageAuthor":"Thinh Pham","imageFallback":"lidl-photo-p19"},{"id":"d7m1","day":7,"slot":0,"type":"Śniadanie","title":"Owsianka z chrupiącymi płatkami","description":"Owsianka na mleku ze skyrem, mrożonymi malinami, borówkami, masłem orzechowym i 20 g płatków śniadaniowych.","ingredients":["Płatki owsiane","Mleko 1,5%","Skyr","Maliny mrożone","Borówki","Masło orzechowe 100%","Płatki śniadaniowe (20 g)"],"imageKey":"lidl-photo-p08b"},{"id":"d7m2","day":7,"slot":1,"type":"II śniadanie","title":"Smoothie ze szpinakiem","description":"Banan, mrożone maliny, świeży szpinak, skyr naturalny i napój owsiany.","ingredients":["Banan","Maliny mrożone","Szpinak świeży","Skyr naturalny","Napój owsiany"],"imageKey":"lidl-photo-p17a"},{"id":"d7m3","day":7,"slot":2,"type":"Obiad","title":"Gulasz z indyka i strączków","description":"Mielony indyk z ciecierzycą lub soczewicą, passatą, papryką i cebulą, podany z ziemniakami.","ingredients":["Mięso mielone z indyka 2% tłuszczu","Ciecierzyca|Soczewica","Passata pomidorowa","Papryka","Cebula","Ziemniaki"],"imageKey":"lidl-photo-p16"},{"id":"d7m4","day":7,"slot":3,"type":"Kolacja","title":"Wytrawne naleśniki z łososiem","description":"Naleśniki pełnoziarniste z twarogiem półtłustym, wędzonym łososiem, szpinakiem lub rukolą i serkiem kanapkowym. Przed snem 2 kiwi gold.","ingredients":["Mąka pełnoziarnista","Twaróg półtłusty","Wędzony łosoś","Szpinak|Rukola","Serek kanapkowy","Kiwi gold (2 szt.)"],"imageKey":"dash-d6-s2","image":"https://images.unsplash.com/photo-1756138369555-41ef2a10d1df?auto=format&fit=crop&w=750&q=78","imageSource":"https://unsplash.com/photos/salmon-salad-with-fresh-greens-and-lime-ery1HIXFDKw","imageAuthor":"Thinh Pham","imageFallback":"dash-d6-s2"}];
// Osobna kolekcja przekąsek. Kolejne pomysły dopisujemy tutaj, bez zmiany jadłospisu.
// Format: {id:'s1', type:'Przekąska', title:'...', description:'...', ingredients:['...']}.
// Nowe dania z jadłospisu „1700kcal LIDL” i osiem kolacji z nagrania.
const EXTRA_RECIPES = [{"id":"lidl-mon-breakfast","day":0,"slot":0,"type":"Śniadanie","title":"Jajecznica paprykowo-pomidorowa","description":"Jajka z papryką, pomidorkami i szczypiorkiem, podane z chlebem drwalskim.","ingredients":["Jajka (2 szt.)","Szczypiorek (20 g)","Chleb drwalski Lidl (80 g)","Papryka czerwona (230 g)","Pomidorki koktajlowe (100 g)","Masło (10 g)"],"source":"lidl","sourceDay":1,"imageKey":"lidl-photo-p02"},{"id":"lidl-mon-second","day":0,"slot":1,"type":"II śniadanie","title":"Szejk kawowo-bananowy","description":"Koktajl z banana, kawy espresso, niesłodzonego napoju migdałowego i wanilii.","ingredients":["Banan (120 g)","Ekstrakt waniliowy (2 g)","Kawa espresso (50 ml)","Napój migdałowy bez cukru (250 ml)"],"source":"lidl","sourceDay":1,"imageKey":"lidl-photo-p17a"},{"id":"lidl-mon-lunch","day":0,"slot":2,"type":"Obiad","title":"Dorsz po włosku z fasolką szparagową","description":"Pieczony dorsz z pomidorami, fasolką szparagową, kaszą jęczmienną i ziołami.","ingredients":["Kasza jęczmienna perłowa (40 g)","Fasolka szparagowa mrożona (200 g)","Czosnek (5 g)","Dorsz świeży (150 g)","Oliwa z oliwek (10 ml)","Natka pietruszki (20 g)","Pomidor (340 g)","Oregano","Pieprz","Sól","Sok z cytryny (12 ml)"],"source":"lidl","sourceDay":1,"imageKey":"lidl-photo-p03"},{"id":"lidl-mon-dinner","day":0,"slot":3,"type":"Kolacja","title":"Sałatka z rukoli i pieczonych batatów","description":"Pieczone bataty z ciecierzycą, rukolą, suszonymi pomidorami i sezamem.","ingredients":["Batat (150 g)","Ciecierzyca sucha (45 g)","Rukola (19 g)","Suszone pomidory w oleju (17 g)","Czosnek (6 g)","Oliwa z oliwek (5 ml)","Sezam (1 g)","Rozmaryn","Tymianek","Sól","Pieprz"],"source":"lidl","sourceDay":1,"imageKey":"lidl-photo-p04"},{"id":"lidl-tue-breakfast","day":0,"slot":0,"type":"Śniadanie","title":"Skyr z musli i bananem","description":"Skyr naturalny z musli, bananem i niewielką ilością miodu.","ingredients":["Skyr naturalny (150 g)","Musli (65 g)","Banan (130 g)","Miód (15 g)"],"source":"lidl","sourceDay":2,"imageKey":"lidl-photo-p05"},{"id":"lidl-tue-second","day":0,"slot":1,"type":"II śniadanie","title":"Baton zbożowy i jabłko","description":"Proste drugie śniadanie z batonem zbożowym Dobra Kaloria i świeżym jabłkiem.","ingredients":["Baton Dobra Kaloria (42 g)","Jabłko (200 g)"],"source":"lidl","sourceDay":2,"imageKey":"dash-d3-s1"},{"id":"lidl-tue-lunch","day":0,"slot":2,"type":"Obiad","title":"Burger warzywny z surówką","description":"Gotowy burger warzywny w bułce żytniej z surówką marchwiowo-jabłkową i musztardą.","ingredients":["Burger warzywny Dobra Kaloria (100 g)","Bułka żytnia (80 g)","Surówka z marchwi i jabłka (100 g)","Musztarda (10 g)"],"source":"lidl","sourceDay":2,"imageKey":"dash-d6-s4","image":"https://images.unsplash.com/photo-1626414375188-805f321bd821?auto=format&fit=crop&w=750&q=78","imageSource":"https://unsplash.com/photos/burger-with-lettuce-and-tomatoes-on-white-ceramic-plate-s0F4jJCO1Ug","imageAuthor":"Bakd&Raw / Karolin Baitinger","imageFallback":"dash-d6-s4"},{"id":"lidl-tue-dinner","day":0,"slot":3,"type":"Kolacja","title":"Grzanka czosnkowa z pomidorem","description":"Zapieczony chleb drwalski z oliwą i czosnkiem, obłożony pomidorem, cebulą i ziołami.","ingredients":["Chleb drwalski Lidl (80 g)","Pomidor (130 g)","Cebula (30 g)","Czosnek (7 g)","Oliwa z oliwek (10 ml)","Cytryna (10 g)","Majeranek","Oregano","Pieprz"],"source":"lidl","sourceDay":2,"imageKey":"lidl-photo-p06"},{"id":"lidl-wed-breakfast","day":0,"slot":0,"type":"Śniadanie","title":"Serek wiejski z warzywami i pieczywem","description":"Serek wiejski ze szczypiorkiem, rzodkiewką i siemieniem, podany z papryką i chlebem.","ingredients":["Serek wiejski (130 g)","Chleb żytni razowy (70 g)","Papryka czerwona (120 g)","Rzodkiewka (75 g)","Szczypiorek (20 g)","Siemię lniane (5 g)","Masło (10 g)","Sól"],"source":"lidl","sourceDay":3,"imageKey":"lidl-photo-p13"},{"id":"lidl-wed-second","day":0,"slot":1,"type":"II śniadanie","title":"Cynamonowa o