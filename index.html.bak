<!doctype html>
<html lang="pl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#173a2c" />
  <meta name="dt-app-version" content="2.7" />
  <meta name="description" content="Dobry Talerz — pomysły na posiłki i lista zakupów w jednym miejscu." />
  <link rel="manifest" href="manifest.webmanifest" />
  <link rel="icon" type="image/png" href="icon-192.png" />
  <title>Dobry Talerz · Posiłki i zakupy</title>
<style>
:root{--green:#173a2c;--forest:#234936;--lime:#d8eabb;--paper:#f6f8f3;--surface:#fff;--muted:#617268;--border:#e4eae2;--yellow:#f7dc98;--ink:#1e2d25;--shadow:0 12px 35px rgba(22,57,42,.07)}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;-webkit-font-smoothing:antialiased}button,input,select{font:inherit}button{cursor:pointer}button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #84b762;outline-offset:2px}button:disabled{opacity:.45;cursor:not-allowed}a{color:inherit}.shell{max-width:1240px;margin:auto;padding:0 28px 60px}
.header{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:25px 0 26px}.brand{display:flex;align-items:center;gap:13px;min-width:0}.logo{height:47px;width:47px;background:var(--green);border-radius:16px;display:grid;place-items:center;font-size:24px;box-shadow:0 6px 16px #1b47351c}.brand-main{font-weight:850;letter-spacing:-.7px;font-size:21px;line-height:1.1}.brand-sub{font-size:12px;color:var(--muted);margin-top:5px}.top-nav{display:flex;padding:5px;background:white;border:1px solid var(--border);border-radius:16px;gap:3px}.nav-btn{border:0;background:transparent;border-radius:11px;color:#586b60;padding:12px 17px;font-weight:720;display:flex;align-items:center;gap:9px}.nav-btn.active{background:var(--green);color:white}.cart-top{background:#eaf2dd;border:0;padding:13px 17px;border-radius:14px;color:var(--green);font-weight:800}.count{display:inline-grid;place-items:center;font-size:12px;min-width:24px;height:24px;margin-left:7px;padding:0 6px;color:white;background:var(--green);border-radius:20px}.view{display:none}.view.active{display:block}
.hero{min-height:263px;border-radius:30px;background:var(--green);color:#fff;overflow:hidden;position:relative;display:flex;justify-content:space-between;gap:18px;padding:35px 44px}.hero:after{content:"";position:absolute;width:360px;height:360px;border:1px solid #ffffff24;border-radius:50%;right:-60px;top:-145px;pointer-events:none}.hero-text{position:relative;z-index:1;max-width:630px}.eyebrow{font-size:12px;font-weight:830;text-transform:uppercase;letter-spacing:1.8px;color:#c7e5af;display:flex;gap:8px;align-items:center}.hero h1{font-weight:850;font-size:clamp(30px,4.2vw,49px);letter-spacing:-1.8px;line-height:1.13;margin:18px 0 13px}.hero p{font-size:15px;color:#deede0;line-height:1.7;margin:0;max-width:560px}.hero-icons{position:relative;min-width:285px;align-self:stretch}.plate{position:absolute;width:242px;height:242px;right:24px;top:-21px;background:#fafcf0;border:15px solid #d9e8d4;border-radius:50%;box-shadow:0 20px 30px #061f1561;display:grid;place-items:center;transform:rotate(-14deg)}.plate:before{content:"";position:absolute;width:165px;height:165px;border-radius:50%;border:2px solid #e5eadd}.plate span{font-size:105px;filter:drop-shadow(0 5px 4px #00000015)}.chip-float{position:absolute;z-index:2;background:#f1da94;color:#344226;right:4px;bottom:1px;border-radius:30px;padding:11px 16px;font-size:13px;font-weight:800;box-shadow:0 8px 22px #10281b54;transform:rotate(5deg)}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:20px 0 33px}.stat{border:1px solid var(--border);padding:20px 23px;background:white;border-radius:20px;display:flex;align-items:center;gap:16px}.stat-symbol{background:#eef5e8;border-radius:14px;width:45px;height:45px;display:grid;place-items:center;font-size:23px;flex:none}.stat-num{font-weight:850;font-size:25px;line-height:1;letter-spacing:-.6px}.stat-label{font-size:13px;color:var(--muted);margin-top:5px}
.section-title{display:flex;align-items:end;justify-content:space-between;gap:16px;margin:0 0 20px}.section-title h2{font-size:26px;font-weight:850;letter-spacing:-.75px;margin:0 0 7px}.section-title p{font-size:14px;color:var(--muted);margin:0}.quiet{font-size:12px;color:var(--muted)}.filters{background:white;border-radius:21px;padding:17px;border:1px solid var(--border);box-shadow:0 4px 15px #18382505;margin-bottom:24px}.filter-row{display:flex;align-items:center;gap:12px;flex-wrap:wrap}.filter-row+.filter-row{margin-top:14px}.filter-label{font-size:12px;font-weight:850;color:#76877e;text-transform:uppercase;letter-spacing:.9px;min-width:82px}.pills{display:flex;align-items:center;gap:7px;flex-wrap:wrap}.pill{border:1px solid #e1e9df;background:#f8faf6;color:#54675b;border-radius:999px;padding:9px 14px;font-size:13px;font-weight:730}.pill.active{color:white;background:var(--green);border-color:var(--green)}.search{margin-left:auto;min-width:230px;border:1px solid var(--border);border-radius:13px;display:flex;align-items:center;gap:9px;padding:0 13px;background:#fafcf9;color:#8a9a8f}.search input{border:0;background:transparent;outline:none;width:100%;padding:11px 0;color:var(--ink);font-size:13px}.search input:focus{outline:none}.meal-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.meal-card{background:#fff;border:1px solid var(--border);border-radius:24px;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 5px 15px rgba(18,42,27,.025);transition:transform .2s,box-shadow .2s,border-color .2s;min-height:100%}.meal-card:hover{transform:translateY(-3px);box-shadow:var(--shadow);border-color:#bacfb5}.meal-thumb{aspect-ratio:4/3;background:#eef5e8;overflow:hidden;position:relative}.meal-thumb img{width:100%;height:100%;object-fit:cover;display:block}.meal-body{padding:15px 16px 14px;display:flex;flex-direction:column;flex:1}.card-top{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:11px}.food-icon{height:41px;width:41px;background:#eef5e8;border-radius:14px;display:grid;place-items:center;font-size:23px;flex:none}.day-tag{font-size:11px;color:#517358;background:#edf5e8;border-radius:30px;padding:7px 10px;font-weight:820;max-width:70%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.meal-type{font-size:11px;text-transform:uppercase;letter-spacing:1px;color:#809488;font-weight:850;margin:0 0 7px}.meal-card h3{font-size:18px;line-height:1.26;letter-spacing:-.4px;margin:0 0 10px}.meal-card p{font-size:13px;color:#6b7c71;line-height:1.55;margin:0 0 18px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.meal-open{margin-top:auto;display:flex;gap:8px;align-items:center;justify-content:space-between;width:100%;border:0;border-top:1px solid #eef0ec;background:transparent;padding:14px 0 0;color:#24623e;font-weight:830;font-size:13px}.meal-open span:last-child{font-size:18px}.empty{text-align:center;background:#fff;border:1px dashed #b7c8b4;border-radius:18px;padding:44px 12px;color:#6b7c71}
.shopping-hero{background:#e6f0df;border-radius:25px;padding:30px 32px;display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:21px}.shopping-hero h1,.plan-hero h1{font-size:32px;letter-spacing:-1px;margin:0 0 9px}.shopping-hero p,.plan-hero p{font-size:14px;color:#5a7260;line-height:1.6;margin:0}.shopping-symbol{font-size:67px;line-height:1}.shop-actions{display:flex;flex-wrap:wrap;gap:9px;align-items:center;margin:21px 0}.btn{border:0;background:var(--green);color:white;border-radius:12px;padding:12px 17px;font-weight:810;font-size:13px;display:inline-flex;align-items:center;justify-content:center;gap:9px}.btn.ghost{background:#fff;color:var(--forest);border:1px solid var(--border)}.btn.warn{background:#fff4eb;color:#a35237;border:1px solid #f2dac8}.add-own{display:flex;gap:8px;flex:1;min-width:200px}.add-own input{flex:1;min-width:0;border:1px solid var(--border);border-radius:12px;padding:12px 14px;background:#fff;font-size:13px}.shop-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;align-items:start}.shop-category{background:white;border-radius:20px;border:1px solid var(--border);padding:20px}.cat-head{display:flex;justify-content:space-between;align-items:center;gap:9px;border-bottom:1px solid #ecf0e9;padding-bottom:14px;margin-bottom:5px}.cat-head h3{font-size:16px;margin:0}.cat-count{font-size:12px;background:#eff4ea;color:#4c6f53;padding:6px 10px;border-radius:40px}.shop-row{display:flex;align-items:center;gap:10px;padding:12px 0;border-bottom:1px solid #f0f2ed}.shop-row:last-child{border:0}.shop-check{width:20px;height:20px;accent-color:#336a42;flex:none}.shop-name{font-weight:690;font-size:13.5px}.shop-row.done .shop-name{text-decoration:line-through;color:#9baa9e}.shop-meta{font-size:11px;color:#8a988e;margin-top:4px}.shop-name-wrap{flex:1;min-width:0}.delete{border:0;color:#b9a6a2;background:transparent;font-size:18px;padding:4px 6px;line-height:1}.shopping-empty{padding:65px 20px;text-align:center;background:white;border:1px dashed #bed1b9;border-radius:25px}.shopping-empty .big{font-size:61px}.shopping-empty h3{font-size:20px;margin:16px 0 8px}.shopping-empty p{color:var(--muted);font-size:14px;margin:0 0 20px}
.plan-hero{margin-bottom:22px}.plan-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.day-panel{background:white;border:1px solid var(--border);border-radius:21px;padding:20px}.day-panel header{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #eaf0e6;margin-bottom:6px;padding:0 0 15px}.day-panel h3{margin:0;font-size:19px}.day-panel header button{border:0;background:#e9f3df;color:var(--green);padding:9px 12px;border-radius:11px;font-weight:820;font-size:12px}.day-line{width:100%;display:flex;align-items:center;gap:12px;padding:14px 0;border:0;border-bottom:1px solid #f0f4ed;background:transparent;text-align:left}.day-line:last-child{border:0}.day-line-emoji{font-size:24px;background:#eef4e8;border-radius:12px;display:grid;place-items:center;height:45px;width:45px;flex:none}.day-line-content{flex:1;min-width:0}.day-line-content small{display:block;font-size:10px;text-transform:uppercase;color:#89998d;letter-spacing:1px;font-weight:840;margin-bottom:5px}.day-line-content strong{display:block;font-size:13px;line-height:1.35}.day-line-arrow{color:#62966b}
.footer{border-top:1px solid #e3e9de;padding-top:25px;margin-top:49px;display:flex;justify-content:space-between;gap:15px;color:#77877c;font-size:12px;line-height:1.5}
.modal-backdrop{position:fixed;inset:0;background:rgba(12,30,20,.57);z-index:50;display:none;align-items:center;justify-content:center;padding:20px}.modal-backdrop.visible{display:flex}.modal{background:white;border-radius:28px;max-width:630px;width:100%;max-height:min(90dvh,810px);overflow:auto;box-shadow:0 40px 90px #001d0d45;position:relative}.modal-media{aspect-ratio:16/9;background:#edf5e8;overflow:hidden}.modal-media img{width:100%;height:100%;object-fit:cover;display:block}.modal-top{background:#edf5e8;padding:27px 32px 24px}.modal-head{display:flex;justify-content:space-between;gap:15px;align-items:start}.modal-close{width:37px;height:37px;flex:none;background:white;border:0;border-radius:11px;color:#5e7763;font-size:25px;line-height:1}.modal-kicker{text-transform:uppercase;letter-spacing:1px;font-size:11px;font-weight:830;color:#5b7d63}.modal-top h2{font-size:27px;line-height:1.13;letter-spacing:-.8px;margin:10px 0}.modal-top p{line-height:1.65;font-size:13px;color:#627565;margin:0}.modal-top.has-media{border-top:1px solid #e3eddd}.modal-photo-credit{font-size:11px!important;opacity:.8;margin-top:10px!important}.modal-photo-credit a{color:#346e47;text-decoration:underline}.modal-body{padding:24px 32px 27px}.modal-titleline{display:flex;justify-content:space-between;align-items:center;gap:15px}.modal-titleline h3{font-size:16px;margin:0 0 8px}.modal-note{font-size:12px;color:#819388;line-height:1.55;margin:0 0 14px}.ingredients-list{display:flex;flex-direction:column;gap:9px;margin-top:17px}.ingredient-row{background:#f7faf5;border:1px solid #ebf0e6;border-radius:13px;display:flex;align-items:center;gap:11px;min-height:48px;padding:9px 12px}.ingredient-row input[type=checkbox]{width:19px;height:19px;accent-color:#286443;flex:none}.ingredient-name{font-size:13.5px;font-weight:670;flex:1;line-height:1.35}.ingredient-row select{border:1px solid #dce7d7;background:white;border-radius:10px;max-width:220px;min-width:0;padding:9px;color:#315543;font-size:12px}.modal-foot{display:flex;gap:11px;align-items:center;margin-top:22px}.modal-foot .btn{flex:1;padding:16px}.modal-foot small{font-size:11px;color:#8ba094}.toast{position:fixed;left:50%;bottom:24px;transform:translate(-50%,20px);background:var(--green);color:white;z-index:70;opacity:0;pointer-events:none;transition:.18s ease;max-width:calc(100vw - 36px);border-radius:13px;padding:13px 20px;font-size:13px;font-weight:730;text-align:center;box-shadow:0 12px 32px #03240d43}.toast.show{opacity:1;transform:translate(-50%,0)}.bottom-nav{display:none}
@media(max-width:980px){.hero-icons{min-width:220px}.plate{right:-30px}.meal-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.nav-btn{padding:11px}.header{gap:12px}.brand-sub{display:none}}
@media(min-width:681px) and (max-width:860px){.nav-btn{font-size:12px;padding:10px 8px;gap:5px}.top-nav{gap:0}.header{gap:8px}.brand-main{font-size:19px}}
@media(max-width:680px){.shell{padding:0 15px 105px}.header{padding:17px 0 19px}.logo{width:41px;height:41px;border-radius:13px;font-size:21px}.brand-main{font-size:19px}.top-nav{display:none}.cart-top{padding:10px 12px;font-size:12px}.hero{border-radius:22px;padding:25px 24px;min-height:225px}.hero h1{font-size:31px;line-height:1.12;letter-spacing:-1.1px;margin:15px 0 9px;max-width:290px}.hero p{font-size:12.5px;line-height:1.6;max-width:265px}.eyebrow{font-size:10px;letter-spacing:1px}.hero-icons{position:absolute;inset:0;pointer-events:none;min-width:0;z-index:0;opacity:.27}.plate{width:195px;height:195px;right:-49px;top:56px;border-width:9px}.plate:before{width:110px;height:110px}.plate span{font-size:70px}.chip-float{display:none}.stats{gap:8px;margin:13px 0 25px}.stat{border-radius:15px;display:block;text-align:center;padding:15px 5px}.stat-symbol{height:33px;width:33px;border-radius:11px;font-size:19px;margin:0 auto 10px}.stat-num{font-size:21px}.stat-label{font-size:10px;white-space:nowrap}.section-title h2{font-size:23px}.section-title p{font-size:12px}.filters{padding:13px;border-radius:17px}.filter-row{gap:8px}.filter-label{min-width:100%;font-size:10px}.pills{width:100%;overflow:auto;flex-wrap:nowrap;padding-bottom:2px}.pill{font-size:12px;padding:9px 12px;white-space:nowrap}.search{margin:0;min-width:100%;width:100%}.meal-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.meal-card{border-radius:19px}.meal-thumb{aspect-ratio:1.18}.meal-body{padding:13px}.food-icon{height:34px;width:34px;border-radius:12px;font-size:20px}.day-tag{max-width:60%;font-size:10px;padding:6px 8px}.meal-card h3{font-size:15px}.meal-card p{font-size:12px;-webkit-line-clamp:2}.meal-type{margin:0 0 6px}.meal-open{padding-top:12px;font-size:12px}.shopping-hero{padding:21px;border-radius:21px}.shopping-hero h1,.plan-hero h1{font-size:25px}.shopping-hero p,.plan-hero p{font-size:12px}.shopping-symbol{font-size:50px}.shop-actions{gap:7px}.add-own{min-width:100%;order:-1}.shop-list,.plan-grid{grid-template-columns:1fr;gap:12px}.shop-category,.day-panel{padding:17px}.modal-backdrop{align-items:flex-end;padding:0}.modal{border-radius:24px 24px 0 0;max-height:92dvh}.modal-media{border-radius:24px 24px 0 0}.modal-top{padding:22px 22px 19px}.modal-top h2{font-size:23px}.modal-body{padding:19px 22px 26px}.ingredient-row select{max-width:150px}.ingredient-name{font-size:12.5px}.modal-foot{flex-direction:column}.modal-foot .btn{width:100%}.footer{font-size:11px;display:block}.footer div+div{margin-top:7px}.toast{bottom:86px}.bottom-nav{position:fixed;display:flex;left:0;right:0;bottom:0;z-index:30;background:#fff;box-shadow:0 -4px 24px #153c2618;border-top:1px solid var(--border);padding:8px 12px calc(8px + env(safe-area-inset-bottom));justify-content:space-around}.bottom-nav .bottom-item{border:0;background:transparent;color:#839388;display:grid;justify-items:center;gap:4px;min-width:0;flex:1;padding:7px 3px;border-radius:13px;font-size:10px;font-weight:800}.bottom-item .emoji{font-size:21px}.bottom-nav .bottom-item.active{color:var(--green);background:#eaf3e4}}
@media(min-width:981px){#view-meals .meal-card{padding:18px;min-height:224px}#view-meals .meal-card h3{font-size:17px}}
/* Własne przekąski */
.snack-form{margin-bottom:27px;max-width:none;gap:10px}
.snack-form h3{font-size:19px}
.snack-help{font-size:12px!important;color:#75867c!important;margin:0!important}
.snack-form-buttons{display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin-top:5px}
.snack-form-buttons .btn{margin:0}
.snack-actions{display:flex;gap:8px;margin-top:12px;align-items:center}
.snack-actions button{font-size:12px;font-weight:750;border:1px solid var(--border);border-radius:10px;background:#f7faf5;color:#386345;padding:8px 12px}
.snack-actions .snack-delete{background:#fff4ee;color:#a7533f;border-color:#f3dfd1}
.snack-empty{grid-column:1/-1}
[hidden]{display:none!important}
@media(max-width:680px){.snack-form{padding:19px}.snack-form-buttons .btn{width:auto;flex:1}.snack-form-buttons .btn:first-child{flex:2}.snack-actions button{flex:1}}
/* Nowe działy: biblioteka składników i dobre nawyki */
.library-tools{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:21px;align-items:stretch}.library-search,.library-add{display:flex;align-items:center;gap:10px;background:white;border:1px solid var(--border);border-radius:14px;padding:7px 12px;flex:1;min-width:240px}.library-search{color:#829289}.library-search input,.library-add input{border:0;background:transparent;outline:0;padding:7px 0;width:100%;min-width:0;font-size:13px;color:var(--ink)}.library-add .btn{white-space:nowrap}.catalog-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px;align-items:start}.catalog-group{border:1px solid var(--border);background:white;border-radius:20px;padding:19px}.catalog-group h3{font-size:16px;letter-spacing:-.3px;margin:0 0 11px;display:flex;align-items:center;justify-content:space-between;gap:7px}.catalog-group h3 small{font-size:11px;background:#eaf3e4;color:#527052;border-radius:999px;padding:4px 10px}.catalog-row{display:flex;gap:12px;align-items:center;justify-content:space-between;padding:11px 0;border-top:1px solid #edf1e9}.catalog-name{font-size:13px;font-weight:750;line-height:1.35;margin:0}.catalog-source{margin:4px 0 0;font-size:11px;color:#7b8b80;line-height:1.45}.catalog-add{white-space:nowrap;flex:none;border:1px solid #d8e7d4;border-radius:10px;background:#f0f6eb;color:var(--green);font-weight:780;padding:8px 10px;font-size:11px}.tips-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px;margin-bottom:22px}.tip-card{padding:23px;border:1px solid var(--border);border-radius:22px;background:#fff}.tip-card .tip-kicker{font-size:11px;font-weight:800;color:#59805e;text-transform:uppercase;letter-spacing:.7px}.tip-card h3{font-size:19px;letter-spacing:-.4px;margin:10px 0 11px}.tip-card p{font-size:14px;color:#586f60;line-height:1.7;margin:0;white-space:pre-line}.tip-card .tip-footer{display:flex;justify-content:space-between;align-items:center;gap:9px;margin-top:17px;font-size:11px;color:#7d9082}.tip-delete{border:0;background:#fff3ed;color:#ae6046;padding:8px 10px;border-radius:9px;font-size:11px;font-weight:700}.tip-form{max-width:760px;background:white;border:1px solid var(--border);padding:24px;border-radius:22px;display:grid;gap:11px}.tip-form h3{margin:0;font-size:19px}.tip-form p{margin:0 0 5px;color:#6c7e71;font-size:13px;line-height:1.5}.tip-form label{font-size:12px;font-weight:800;color:#557060}.tip-form input,.tip-form textarea{width:100%;background:#f9fbf7;color:var(--ink);border:1px solid #dce6d9;border-radius:12px;padding:12px 14px;font:inherit;font-size:14px}.tip-form textarea{resize:vertical}.tip-form .btn{justify-self:start;margin-top:3px}.nav-btn{white-space:nowrap}
@media(min-width:1161px){.nav-btn{padding:11px 8px;font-size:12px;gap:6px}.brand{flex:none}.top-nav{flex:1;justify-content:center}}
@media(min-width:681px) and (max-width:1160px){.header{flex-wrap:wrap}.top-nav{order:3;width:100%;justify-content:center}.cart-top{margin-left:auto}.nav-btn{padding:10px 12px}}
@media(max-width:680px){.shell{padding-bottom:154px}.catalog-grid,.tips-grid{grid-template-columns:1fr}.library-tools{gap:9px}.library-search,.library-add{min-width:100%}.catalog-group{padding:16px}.catalog-row{gap:6px}.catalog-add{font-size:10px;padding:8px}.tip-form{padding:19px}.tip-form .btn{width:100%}.bottom-nav{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));row-gap:2px;column-gap:5px;padding:5px 8px calc(5px + env(safe-area-inset-bottom))}.bottom-nav .bottom-item{padding:5px 3px;gap:2px;min-width:0;width:100%;font-size:10px}.bottom-item .emoji{font-size:19px}.toast{bottom:115px}}
@media(max-width:930px){.meal-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:420px){.meal-grid{grid-template-columns:1fr}}

.plan-toolbar{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:20px;padding:17px 19px;border-radius:19px;border:1px solid var(--border);background:#fff}
.plan-toolbar-copy{display:grid;gap:5px;max-width:430px}
.plan-toolbar-copy strong{font-size:15px;color:var(--ink)}
.plan-toolbar-copy span{font-size:12px;line-height:1.5;color:var(--muted)}
.plan-toolbar-actions{display:flex;gap:9px;flex-wrap:wrap;justify-content:flex-end}
.day-panel header{gap:10px;flex-wrap:wrap}
.day-panel-actions{display:flex;gap:7px;align-items:center;flex-wrap:wrap}
.day-panel header .day-shuffle{background:#f1f4f8;color:#425e76}
.day-line-image{height:52px;width:58px;object-fit:cover;border-radius:11px;background:#eef4e8;flex:none}
@media(max-width:860px){.plan-toolbar{flex-direction:column;align-items:stretch}.plan-toolbar-actions{justify-content:flex-start}}
@media(max-width:680px){.plan-toolbar{padding:14px;border-radius:16px}.plan-toolbar-actions{flex-direction:column}.plan-toolbar-actions .btn{width:100%;min-height:44px}.day-panel header{align-items:flex-start}.day-panel-actions button{padding:9px 10px}.day-line-image{height:48px;width:53px}}

.tips-tools{display:grid;gap:12px;margin:0 0 18px}.tips-search{background:#fff;border:1px solid var(--border);border-radius:14px;padding:10px 14px;display:flex;align-items:center;gap:10px}.tips-search input{border:0;background:transparent;width:100%;min-width:0;font:inherit;font-size:14px;color:var(--ink);outline:0}.tips-search:focus-within{border-color:#2c7148;box-shadow:0 0 0 3px #276e421b}.tips-categories{display:flex;flex-wrap:wrap;gap:8px}.tips-categories button{border:1px solid #d6e3d2;background:#fff;color:#356048;border-radius:999px;padding:8px 12px;font-size:12px;font-weight:750;cursor:pointer}.tips-categories button.active{background:var(--green);border-color:var(--green);color:#fff}.tip-card{height:100%;display:flex;flex-direction:column}.tip-card .tip-footer{margin-top:auto;padding-top:14px}.tips-empty{grid-column:1/-1;background:#fff;border:1px dashed #cad8c5;border-radius:18px;padding:30px 18px;color:#617969;text-align:center}
@media(max-width:680px){.tips-categories{flex-wrap:nowrap;overflow-x:auto;scrollbar-width:thin;padding-bottom:6px;margin-right:-15px}.tips-categories button{white-space:nowrap;flex:none}.tips-search{padding:10px 12px}}

.prep-panel{margin:0 0 26px;border:1px solid #dcebd4;border-radius:18px;background:#f5faf1;padding:20px 21px}.prep-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:16px}.prep-head h3{margin:0;font-size:17px;line-height:1.3;color:#214532}.prep-count{font-size:11px;color:#52755a;font-weight:780;white-space:nowrap}.prep-steps{list-style:none;margin:0;padding:0;counter-reset:prep;display:grid;gap:13px}.prep-steps li{position:relative;padding-left:41px;font-size:14px;line-height:1.65;color:#344d3e;counter-increment:prep;min-height:30px}.prep-steps li:before{content:counter(prep);position:absolute;left:0;top:1px;width:27px;height:27px;background:#dbeccc;border:1px solid #c8dfb9;border-radius:9px;display:grid;place-items:center;font-size:12px;font-weight:850;color:#27553a}.prep-origin{border-top:1px solid #e2eddc;padding-top:12px;margin:17px 0 0;font-size:11px;line-height:1.6;color:#67816e}.prep-ref{font-size:12px;margin:7px 0 0;color:#52755a}.prep-ref a{font-weight:750;text-decoration:underline;text-underline-offset:2px}@media(max-width:680px){.prep-panel{padding:16px 15px;margin-bottom:20px}.prep-steps li{font-size:13px;line-height:1.58;padding-left:36px}.prep-head h3{font-size:16px}.prep-count{font-size:10px}}

/* Wersja aplikacji jest zawsze widoczna, także w aplikacji w Docku. */
.update-strip{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;margin:-9px 0 18px;border:1px solid #cae3c8;border-radius:15px;background:#edf7e8;padding:10px 15px;color:#28523b;font-size:12px}
.update-copy{display:flex;align-items:center;flex-wrap:wrap;gap:10px;font-weight:670}
.update-version{border-radius:100px;background:#1d5a3a;color:#fff;padding:5px 10px;font-weight:850;white-space:nowrap}
.update-button{border:1px solid #a4c7ab;background:#fff;color:#245638;border-radius:9px;font-weight:820;padding:8px 13px;font-size:12px;white-space:nowrap}
.update-button:hover{background:#e0f1dc}
.update-button:disabled{opacity:.55}
@media(max-width:680px){.update-strip{margin:-6px 0 13px;padding:9px 11px;gap:9px;font-size:11px}.update-button{padding:7px 10px;font-size:11px}}

/* Dobry Talerz 2.7: wyszukiwanie wg posiadanych produktów i oficjalne źródła */
.sr-label{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}
.pantry-finder{background:#fff;border:1px solid #dce8d6;box-shadow:0 10px 28px #183c2910;border-radius:23px;padding:23px 26px;margin:7px 0 24px}
.pantry-heading{display:flex;gap:16px;justify-content:space-between;align-items:flex-start}.pantry-heading h3{margin:0 0 7px;font-size:21px;letter-spacing:-.3px}.pantry-heading p{color:#64766a;line-height:1.6;font-size:13px;margin:0 0 16px;max-width:720px}.pantry-reset{background:#f0f4ed;border:1px solid #d7e4d4;border-radius:12px;padding:9px 12px;color:#265b43;font-size:12px;font-weight:750;white-space:nowrap}
.pantry-entry{display:flex;gap:9px;align-items:stretch;max-width:760px}.pantry-entry input{flex:1;min-width:0;padding:12px 15px;border:1px solid #d9e3d7;border-radius:13px;background:#f8fbf7;outline:0;color:#203d30}.pantry-entry .btn{padding:10px 15px;white-space:nowrap;border-radius:12px}
.pantry-suggestions,.pantry-picked{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:12px}.pantry-suggestions button{background:#f3f7ef;color:#315943;border:1px solid #dce7d9;border-radius:999px;padding:7px 11px;font-size:12px;font-weight:700}.pantry-suggestions button:hover{background:#e3f0dc}.pantry-picked{min-height:15px}.pantry-picked button{background:#1b513c;color:#fff;border:0;border-radius:999px;padding:8px 11px;font-size:12px;font-weight:720;display:flex;align-items:center;gap:7px}.pantry-picked button span{opacity:.78;font-size:17px;line-height:1}.pantry-status{color:#617568;margin:12px 0 0;font-size:12px;line-height:1.5}
.time-selector{display:flex;align-items:center;gap:12px;flex-wrap:wrap}.time-selector select{background:#fff;border:1px solid #dde8d9;border-radius:12px;padding:8px 12px;min-width:152px;color:var(--ink)}.time-selector span{font-size:12px;color:#7a8b80}.meal-time{margin:5px 0 10px;color:#317153;font-size:12px;font-weight:800}.modal-time{display:inline-flex;align-items:center;gap:6px;background:#e1edda;color:#2c644a;border-radius:12px;padding:8px 12px;margin:11px 0 0;font-size:12px;font-weight:800}.day-prep-time{margin-top:5px;font-size:11px;color:#47765d;font-weight:700}
.respo-directory{border:1px solid #d5e2d1;border-radius:23px;background:#fff;margin:30px 0 18px;overflow:hidden}.respo-directory summary{list-style:none;cursor:pointer;padding:22px 26px;display:flex;justify-content:space-between;align-items:center;gap:15px}.respo-directory summary::-webkit-details-marker{display:none}.respo-directory summary strong{font-size:20px;letter-spacing:-.3px}.respo-directory summary small{display:block;color:#697e70;margin-top:6px;font-size:12px}.respo-directory summary>span:last-child{font-size:22px;color:#2d6b4e}.respo-directory-inner{padding:0 26px 25px}.respo-directory-inner>p{color:#64776b;line-height:1.6;font-size:13px;margin:0 0 16px;max-width:900px}.respo-link-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}.respo-link-grid a{display:flex;align-items:center;gap:9px;text-decoration:none;padding:12px 13px;background:#f5f9f2;border:1px solid #e4ebdd;border-radius:13px;font-size:12px;font-weight:740;color:#23543a}.respo-link-grid a span:nth-child(2){flex:1}.respo-link-grid a:hover{background:#e8f4e1}.respo-directory-inner p.respo-footnote{margin:16px 0 0;font-size:11px}.respo-footnote a{text-decoration:underline}
@media(max-width:760px){.pantry-finder{padding:17px;margin-top:10px}.pantry-heading{display:block}.pantry-heading h3{font-size:18px}.pantry-reset{margin-bottom:12px}.pantry-entry{flex-direction:column}.pantry-entry .btn{width:100%;justify-content:center}.respo-link-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.respo-directory summary,.respo-directory-inner{padding-left:16px;padding-right:16px}.respo-directory summary strong{font-size:17px}}
@media(max-width:420px){.respo-link-grid{grid-template-columns:1fr}}

.unified-catalog{border:1px solid var(--border);background:#fff;border-radius:22px;padding:20px;margin:18px 0 20px}
.unified-catalog-head h3{margin:0 0 5px;font-size:19px;color:var(--ink)}
.unified-catalog-head p,.category-note{margin:0 0 16px;font-size:12px;color:var(--muted);line-height:1.5}
.unified-category-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px}
.category-select{display:flex;gap:7px;align-items:center;text-align:left;border:1px solid #dfebe0;background:#f9fbf7;border-radius:12px;color:var(--ink);font-weight:700;padding:12px 10px;cursor:pointer;font-size:12px;min-width:0}
.category-select>span:nth-child(2){flex:1;line-height:1.2}
.category-select small{font-weight:800;opacity:.55;font-size:10px}
.category-select.active{background:#174d35;color:#fff;border-color:#174d35}
.category-select:focus-visible{outline:3px solid #92caa5;outline-offset:1px}
.unified-catalog .category-note{margin:12px 0 0}
@media(max-width:1000px){.unified-category-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:620px){.unified-catalog{padding:14px}.unified-category-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.category-select{padding:10px 7px;font-size:11px;gap:5px}}
</style>
</head>
<body>
<div class="shell">
<header class="header">
  <div class="brand"><div class="logo" aria-hidden="true">🥬</div><div><div class="brand-main">Dobry Talerz<span style="color:#79a35c">.</span></div><div class="brand-sub">Posiłki i zakupy bez chaosu</div></div></div>
  <nav class="top-nav" aria-label="Główna nawigacja"><button class="nav-btn active" data-view="meals">🍽️ Posiłki</button><button class="nav-btn" data-view="snacks">🍎 Przekąski</button><button class="nav-btn" data-view="ingredients">🥕 Składniki</button><button class="nav-btn" data-view="tips">💡 Dobre nawyki</button><button class="nav-btn" data-view="plan">🗓️ Plan 4 dni</button><button class="nav-btn" data-view="shopping">🛒 Lista zakupów</button></nav>
  <button class="cart-top" data-view="shopping" aria-label="Otwórz listę zakupów">🛒 Zakupy <span class="count" data-cart-count>0</span></button>
</header>
<div class="update-strip" aria-label="Informacje o wersji aplikacji">
  <div class="update-copy"><span class="update-version">Wersja 2.8</span><span>📚 Jeden katalog · 🥕 Szukanie po składnikach · ⏱️ Czas</span></div>
  <button type="button" class="update-button" id="force-app-refresh" title="Sprawdź aktualizację i pobierz najnowszą wersję aplikacji">⟳ Odśwież aplikację</button>
</div>
<main>
<section class="view active" id="view-meals" aria-label="Pomysły na posiłki">
 <div class="hero"><div class="hero-text"><div class="eyebrow">✦ Zdrowiej i wygodniej każdego dnia</div><h1>Co dobrego<br>dziś zjemy?</h1><p>Jedna baza dań z różnych jadłospisów oraz nowych autorskich inspiracji. Wybierz kategorię, składniki i sprawdź instrukcję gotowania bez opuszczania aplikacji.</p></div><div class="hero-icons" aria-hidden="true"><div class="plate"><span>🥗</span></div><div class="chip-float">✓ Proste zakupy</div></div></div>
 <div class="stats"><div class="stat"><span class="stat-symbol">🍲</span><div><div class="stat-num" id="stat-meals">165</div><div class="stat-label">pomysłów</div></div></div><div class="stat"><span class="stat-symbol">🗓️</span><div><div class="stat-num">4</div><div class="stat-label">dni planu</div></div></div><div class="stat"><span class="stat-symbol">🛒</span><div><div class="stat-num" id="stat-shopping">0</div><div class="stat-label">na liście</div></div></div></div>
 <div class="section-title"><div><h2>Wybierz coś pysznego</h2><p>Przeglądaj dania według kategorii, składników i czasu przygotowania.</p></div><span class="quiet" id="results-count">165 wyników</span></div>
 <section class="unified-catalog" aria-labelledby="unified-catalog-heading">
  <div class="unified-catalog-head"><h3 id="unified-catalog-heading">📚 Jedna baza — kategorie dań</h3><p>Wszystkie zapisane przepisy są tutaj, razem. Wybierz kategorię, by przefiltrować bazę bez otwierania innych stron.</p></div>
  <div id="unified-category-grid" class="unified-category-grid"></div>
  <p class="category-note">Kategorie inspirowane układem Centrum Respo. Starsze dania przypisano automatycznie, więc część może pasować do kilku grup. Nowe przepisy są własnymi propozycjami inspirowanymi potrawami znalezionymi w publicznym katalogu; oryginalne opisy i fotografie nie są kopiowane.</p>
</section>
<div class="filters"><div class="filter-row"><span class="filter-label">Dzień</span><div class="pills" id="day-pills"></div><label class="search">⌕ <input id="search-meals" type="search" autocomplete="off" placeholder="Szukaj posiłku lub składnika..." aria-label="Szukaj posiłków" /></label></div><div class="filter-row"><span class="filter-label">Rodzaj</span><div class="pills" id="type-pills"></div></div><div class="filter-row"><span class="filter-label">Czas</span><div class="time-selector"><label for="time-filter" class="sr-label">Maksymalny czas przygotowania</label><select id="time-filter"><option value="0">Dowolny</option><option value="15">do 15 min</option><option value="30">do 30 min</option><option value="60">do 60 min</option></select><span>Czasy są orientacyjne; wyjątek: Respo PDF podaje do 25 min.</span></div></div></div>
 <section class="pantry-finder" aria-labelledby="pantry-heading">
  <div class="pantry-heading"><div><h3 id="pantry-heading">🥕 Co masz w kuchni?</h3><p>Dodaj kilka produktów. Pokażę tylko przepisy zawierające <strong>wszystkie</strong> zaznaczone składniki, np. kurczak <strong>i</strong> makaron.</p></div><button type="button" id="pantry-clear" class="pantry-reset" hidden>Wyczyść wybór</button></div>
  <div class="pantry-entry"><label for="pantry-input" class="sr-label">Produkt do wyszukania</label><input id="pantry-input" type="search" placeholder="Wpisz produkt, np. feta, kurczak…" autocomplete="off"/><button type="button" id="pantry-add" class="btn">+ Dodaj składnik</button></div>
  <div id="pantry-suggestions" class="pantry-suggestions" aria-live="polite"></div>
  <div class="pantry-picked" id="pantry-picked" aria-live="polite"></div>
  <p id="pantry-status" class="pantry-status" aria-live="polite">Możesz wybrać kilka składników. Każdy dodatkowy zawęzi wyniki.</p>
</section>
 <p class="quiet" style="margin:-9px 0 18px">Wybierz dzień, aby zobaczyć jego cztery posiłki z aktualnego planu. Nowy plan wylosujesz w zakładce „Plan 4 dni”.</p>
<div id="meal-grid" class="meal-grid"></div>
</section>
<section class="view" id="view-plan" aria-label="Plan 4 dni">
  <div class="shopping-hero plan-hero"><div><div class="eyebrow" style="color:#4c7a56;margin-bottom:9px">Twój przykładowy jadłospis</div><h1>Plan na 4 dni</h1><p>Śniadanie, II śniadanie, obiad i kolacja na każdy dzień. Losuj nowe zestawy z całej bazy przepisów — bez powtórzeń w planie.</p></div><div class="shopping-symbol" aria-hidden="true">📅</div></div>
  <div class="plan-toolbar">
    <div class="plan-toolbar-copy"><strong>Twój plan posiłków</strong><span>Przykładowe zestawy, bez dopasowania kalorii do Twoich indywidualnych potrzeb. Zmiany zapisują się na tym urządzeniu.</span></div>
    <div class="plan-toolbar-actions"><button type="button" id="randomize-plan" class="btn">🎲 Wylosuj nowy plan na 4 dni</button><button type="button" id="reset-plan" class="btn ghost">↩ Plan początkowy</button></div>
  </div>
  <div id="plan-grid" class="plan-grid"></div>
</section>
 <section class="view" id="view-snacks" aria-label="Pomysły na przekąski">
   <div class="shopping-hero"><div><div class="eyebrow" style="color:#4c7a56;margin-bottom:9px">Coś dobrego między posiłkami</div><h1>🍎 Przekąski</h1><p>Dodawaj własne propozycje bez edytowania plików. Możesz dopisać składniki i jednym kliknięciem dodać je do zakupów.</p></div><div class="shopping-symbol" aria-hidden="true">🍓</div></div>
    <form id="new-snack-form" class="tip-form snack-form">
      <h3 id="snack-form-title">✍️ Dodaj własną przekąskę</h3>
      <p>Wpisz nazwę, a jeśli chcesz również opis i składniki. Przekąska zapisze się w tej przeglądarce.</p>
      <label for="new-snack-title">Nazwa przekąski *</label>
      <input id="new-snack-title" maxlength="100" placeholder="Np. Skyr z malinami" required>
      <label for="new-snack-description">Opis (opcjonalnie)</label>
      <textarea id="new-snack-description" rows="2" maxlength="700" placeholder="Np. Szybka, białkowa przekąska po treningu"></textarea>
      <label for="new-snack-ingredients">Składniki (opcjonalnie)</label>
      <textarea id="new-snack-ingredients" rows="4" maxlength="3000" placeholder="Każdy składnik w nowym wierszu, np.&#10;Skyr naturalny (150 g)&#10;Maliny (80 g)&#10;Orzechy włoskie (15 g)"></textarea>
      <p class="snack-help">Podaj jeden składnik w każdym wierszu. Pojawią się też w bibliotece składników i będzie można dodać je do listy zakupów.</p>
      <div class="snack-form-buttons"><button class="btn" id="snack-submit" type="submit">+ Dodaj przekąskę</button><button class="btn ghost" id="snack-cancel-edit" type="button" hidden>Anuluj edycję</button></div>
    </form>
    <div class="section-title"><div><h2>Pomysły na mały głód</h2><p>Otwórz kartę, by zobaczyć składniki i dodać je do zakupów.</p></div><span class="quiet" id="snack-count">0 przekąsek</span></div>
   <div id="snack-grid" class="meal-grid"></div>
 </section>
<section class="view" id="view-ingredients" aria-label="Baza składników">
  <div class="shopping-hero"><div><div class="eyebrow" style="color:#4c7a56;margin-bottom:9px">Twoja baza produktów</div><h1>🥕 Składniki</h1><p>Wszystkie składniki z przepisów w jednym miejscu. Wyszukuj, sprawdzaj, do których dań pasują, i dodawaj je do zakupów.</p></div><div class="shopping-symbol" aria-hidden="true">🥦</div></div>
  <div class="section-title"><div><h2>Biblioteka składników</h2><p>Lista tworzy się automatycznie z przepisów. Możesz też dopisać własne produkty.</p></div><span class="quiet" id="ingredient-total"></span></div>
  <div class="library-tools"><label class="library-search">⌕ <input id="search-ingredients" type="search" autocomplete="off" placeholder="Szukaj składnika..." aria-label="Szukaj składnika"></label><form id="new-ingredient-form" class="library-add"><input id="new-ingredient" maxlength="120" aria-label="Nazwa nowego składnika" placeholder="Własny składnik..." required><button class="btn" type="submit">+ Dodaj</button></form></div>
  <div class="catalog-grid" id="ingredient-catalog"></div>
</section>
<section class="view" id="view-tips" aria-label="Porady i dobre nawyki">
  <div class="shopping-hero"><div><div class="eyebrow" style="color:#4c7a56;margin-bottom:9px">Małe zmiany, duże korzyści</div><h1>💡 Porady i dobre nawyki</h1><p>Wskazówki o mące, wyborze wędliny, redukcji, diecie elastycznej, lekkostrawnej i codziennych nawykach.</p></div><div class="shopping-symbol" aria-hidden="true">🌱</div></div>
  <div class="section-title"><div><h2>Warto wiedzieć</h2><p>Wszystkie zebrane porady, uporządkowane tematycznie. Możesz je wyszukiwać.</p></div><span class="quiet" id="tip-total"></span></div>
  <div class="tips-tools"><label class="tips-search" for="tips-search-input"><span aria-hidden="true">🔎</span><input id="tips-search-input" placeholder="Szukaj porady, np. mąka, wędlina, sen..." autocomplete="off" aria-label="Szukaj w dobrych nawykach"></label><div class="tips-categories" id="tips-categories" aria-label="Kategorie dobrych nawyków"></div></div><div id="tips-grid" class="tips-grid"></div>
  <form id="new-tip-form" class="tip-form"><h3>✍️ Dodaj własną poradę</h3><p>Wpis zostanie zapisany w tej przeglądarce. Własne wpisy pozostaną zapisane także po aktualizacji aplikacji w tej samej przeglądarce.</p><label for="new-tip-title">Tytuł</label><input id="new-tip-title" maxlength="100" placeholder="Np. Jak wybierać pieczywo?" required><label for="new-tip-body">Treść porady</label><textarea id="new-tip-body" rows="4" maxlength="2000" placeholder="Zapisz wskazówkę..." required></textarea><button type="submit" class="btn">+ Zapisz poradę</button></form>
</section>
 <section class="view" id="view-shopping" aria-label="Lista zakupów">
  <div class="shopping-hero"><div><div class="eyebrow" style="color:#4c7a56;margin-bottom:9px">Wszystko pod ręką</div><h1>Twoja lista zakupów</h1><p>Produkty z wybranych posiłków, pogrupowane kategoriami. Odhaczaj je podczas zakupów.</p></div><div class="shopping-symbol" aria-hidden="true">🧺</div></div>
  <div class="shop-actions"><div class="add-own"><input id="custom-item" placeholder="Dodaj własny produkt..." aria-label="Własny produkt" /><button class="btn" id="add-custom">+ Dodaj</button></div><button class="btn ghost" id="copy-shopping">⎘ Kopiuj listę</button><button class="btn ghost" id="clear-done">✓ Usuń kupione</button><button class="btn warn" id="clear-all">Wyczyść</button></div>
  <div class="quiet" id="shop-progress" style="margin-bottom:16px"></div>
  <div id="shopping-list" class="shop-list"></div>
</section>
</main>
<footer class="footer"><div>Baza: 149 własnych i przekazanych przepisów, w tym PDF LIDL, DASH i Respo. Część pomysłów pochodzi z przesłanych materiałów, a nowe warianty są samodzielnie opracowanymi inspiracjami. Wygenerowane zdjęcia nowych dań nie pochodzą z Centrum Respo.</div><div>Wersja 2.8 · 165 przepisów · wyszukiwarka składników · czasy przygotowania · plan 4 dni. Dane użytkownika zapisują się lokalnie.</div></footer>
</div>
